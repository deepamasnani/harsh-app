# Neon Postgres — pooled URL for the app, unpooled URL for prisma db push
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="change-this-to-a-long-random-string"
ENCRYPTION_KEY="another-long-random-string-for-drive-tokens"

# Must match the live site on Vercel, e.g. https://harsh-hardware.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Cloud → APIs & Services → Credentials → OAuth client type "Web application"
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# The old Desktop client in backend/gdrive-oauth-client.json will not work on Vercel.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

ADMIN_USER="admin"
ADMIN_PASS="admin123"
STAFF_USER="staff"
STAFF_PASS="staff123"

SHOP_NAME="Harsh Hardware"
SHOP_TAGLINE="Cement · Steel · Plumbing · Paint"
SHOP_ADDRESS="Main Market, Your Town"
SHOP_PHONE="98765 43210"
SHOP_GSTIN=""
